# WEIS — World Education & Immigration Services — environment configuration
# Copy this file to ".env" or ".env.local" and adjust as needed.
# All variables are optional; the site runs fully without them.

# POST endpoint that receives qualified lead submissions (Eligibility Check) as JSON.
# When unset, the lead is captured client-side and handed off via the pre-filled
# WhatsApp deep link only (no network request).
# VITE_LEAD_ENDPOINT=https://api.example.com/leads

# POST endpoint that receives contact-form enquiries as JSON.
# When unset, submissions are simulated client-side (no network request).
# VITE_ENQUIRY_ENDPOINT=https://api.example.com/enquiries
